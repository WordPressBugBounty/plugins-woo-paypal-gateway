msgstr "%d 구독이 마이그레이션되었습니다."

#: ppcp/includes/conversion/class-wpg-conversion-controller.php:212
msgid "No backup found."
msgstr "백업을 찾을 수 없습니다."

#. translators: %s: backup date
#: ppcp/includes/conversion/class-wpg-conversion-controller.php:224
#, php-format
msgid "Settings and orders restored from backup created at %s."
msgstr "%s에 생성된 백업에서 복원된 설정 및 주문입니다."

#: ppcp/includes/conversion/class-wpg-conversion-controller.php:293
msgid "Migration Tool"
msgstr "마이그레이션 도구"

#: ppcp/includes/conversion/class-wpg-conversion-controller.php:294
msgid "Migrate from another PayPal plugin to WooPayPal. Your existing settings are backed up before any changes."
msgstr "다른 PayPal 플러그인에서 WooPayPal로 마이그레이션하세요. 변경하기 전에 기존 설정이 백업됩니다."

#: ppcp/includes/conversion/class-wpg-conversion-controller.php:298
msgid "Backup available"
msgstr "백업 가능"

#. translators: %s: backup date
#: ppcp/includes/conversion/class-wpg-conversion-controller.php:302
#, php-format
msgid " from %s."
msgstr "%s부터."

#: ppcp/includes/conversion/class-wpg-conversion-controller.php:306
