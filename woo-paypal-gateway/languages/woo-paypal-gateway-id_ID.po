msgid "Icon"
msgstr "Ikon"

#: ppcp/includes/class-ppcp-paypal-checkout-for-woocommerce-settings.php:560
msgid "Monogram (PP)"
msgstr "Monogram (PP)"

#: ppcp/includes/class-ppcp-paypal-checkout-for-woocommerce-settings.php:561
