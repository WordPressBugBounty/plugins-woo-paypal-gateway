msgstr ""
"Thanh toán từ trang Sản phẩm hoặc Giỏ hàng bỏ qua bước xem xét và đi thẳng "
"đến trang Cảm ơn."

#: ppcp/includes/class-ppcp-paypal-checkout-for-woocommerce-settings.php:2022
msgid "Invoice prefix"
msgstr "Tiền tố hóa đơn"

#: ppcp/includes/class-ppcp-paypal-checkout-for-woocommerce-settings.php:2024
msgid ""
"Please enter a prefix for your invoice numbers. If you use your PayPal "
"account for multiple stores ensure this prefix is unique as PayPal will not "
"allow orders with the same invoice number."
msgstr ""
"Vui lòng nhập tiền tố cho số hóa đơn của bạn. Nếu bạn sử dụng tài khoản "
"PayPal cho nhiều cửa hàng, hãy đảm bảo tiền tố này là duy nhất vì PayPal sẽ "
"không cho phép đơn hàng có cùng số hóa đơn."

