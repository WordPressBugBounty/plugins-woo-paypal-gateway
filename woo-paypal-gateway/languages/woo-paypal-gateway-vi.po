#: admin/feedback/deactivation-feedback-form.php:8
msgid "Return"
msgstr "Quay lại"

#: admin/feedback/deactivation-feedback-form.php:9
msgid "We’re sorry to see you go! 💔"
msgstr "Chúng tôi rất tiếc khi thấy bạn rời đi! 💔"

