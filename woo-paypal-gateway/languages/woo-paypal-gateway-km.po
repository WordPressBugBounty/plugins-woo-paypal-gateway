#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1407
msgid "Your bank needs to approve this. Please contact your card issuer."
msgstr "ធនាគាររបស់អ្នកត្រូវអនុម័តវា។ សូមទាក់ទងអ្នកគ្រប់គ្រងកាត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1408
msgid "We could not find this account. Please check your card details."
msgstr "យើងរកមិនត្រូវគណនេះ។ សូមពិនិត្យមើលព័ត៌មានលម្អិតនៃកាតរបស់អ្នក។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1409
msgid "The bank declined this transaction. Please try another payment method."
msgstr "ធនាគារបានបឋិសេធប្រតិបត្តិការនេះ។ សូមសាកល្បងវិធីបង់ប្រាក់ផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1410
msgid "This transaction is not authorized. Please contact your card issuer."
msgstr "ប្រតិបត្តិការនេះមិនត្រូវបានអនុញ្ញាត។ សូមទាក់ទងអ្នកគ្រប់គ្រងកាត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1411
msgid "There was a processing issue. The payment was reversed."
msgstr "មានបញ្ហាក្នុងការដំណើរការ។ ការបង់ប្រាក់ត្រូវបានប្រតិវត្ត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1412
msgid "A security check failed. Please try again."
msgstr "ការពិនិត្យសុវត្ថិភាពបានបរាជ័យ។ សូមសាកល្បងម្តងទៀត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1413
msgid "The PIN was not accepted."
msgstr "PIN មិនត្រូវបានទទួល។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1414
msgid "Temporary system issue. Please try again later."
msgstr "បញ្ហាប្រព័ន្ធប្រយ័ក្តខ្លៈ។ សូមសាកល្បងម្តងទៀតនៅពេលក្រោយ។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1415
msgid "Payment was canceled."
msgstr "ការបង់ប្រាក់ត្រូវបានលុបបោះ។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1416
msgid "Only part of the amount was approved."
msgstr "ជាទឹកប្រាក់មួយផ្នែកប៉ុណ្ណោះត្រូវបានអនុម័ត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1417
#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1435
msgid "The bank declined this transaction."
msgstr "ធនាគារបានបឋិសេធប្រតិបត្តិការនេះ។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1418
msgid "Invalid data format."
msgstr "ទម្រង់ទិន្នន័យមិនត្រឹមត្រូវ។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1419
msgid "Invalid amount."
msgstr "ទឹកប្រាក់មិនត្រឹមត្រូវ។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1420
msgid "Card issuer/acquirer not allowed for this transaction."
msgstr "អ្នកគ្រប់គ្រងកាត/អ្នកទិញមិនត្រូវបានអនុញ្ញាតសម្រាប់ប្រតិបត្តិការនេះ។"

