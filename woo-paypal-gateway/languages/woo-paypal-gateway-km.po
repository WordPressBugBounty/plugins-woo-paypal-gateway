msgstr "ប្រសិនបើអាសយដ្ឋានវិក្កយបត្រទទេ ហើយ PayPal ផ្តល់អាសយដ្ឋានដឹកជញ្ជូន ការបញ្ជាទិញនឹងប្រើអាសយដ្ឋានដឹកជញ្ជូនជាអាសយដ្ឋានវិក្កយបត្រ។"

#: ppcp/includes/class-ppcp-paypal-checkout-for-woocommerce-settings.php:2005
msgid "Send Item Details"
msgstr "ផ្ញើព័ត៌មានលម្អិតនៃទំនិញ"

#: ppcp/includes/class-ppcp-paypal-checkout-for-woocommerce-settings.php:2006
msgid "Send line item details to PayPal"
msgstr "ផ្ញើព័ត៌មានលម្អិតនៃបន្ទាត់ទំនិញទៅ PayPal"

#: ppcp/includes/class-ppcp-paypal-checkout-for-woocommerce-settings.php:2008
msgid "Include all line item details in the payment request to PayPal so that they can be seen from the PayPal transaction details page."
msgstr "រួមបញ្ចូលព័ត៌មានលម្អិតនៃបន្ទាត់ទំនិញទាំងអស់នៅក្នុងសំណើបង់ប្រាក់ទៅ PayPal ដើម្បីឱ្យពួកគេអាចមើលបានពីទំព័រព័ត៌មានលម្អិតប្រតិបត្តិការ PayPal។"

#: ppcp/includes/class-ppcp-paypal-checkout-for-woocommerce-settings.php:2012
msgid "Order Review Page"
msgstr "ទំព័រពិនិត្យការបញ្ជាទិញ"

#: ppcp/includes/class-ppcp-paypal-checkout-for-woocommerce-settings.php:2013
msgid "Skip Order Review Page"
msgstr "រំលងទំព័រពិនិត្យការបញ្ជាទិញ"

#: ppcp/includes/class-ppcp-paypal-checkout-for-woocommerce-settings.php:2015
msgid "Payments from the Product or Cart page skip the review step and go straight to the Thank You page."
msgstr "ការបង់ប្រាក់ពីទំព័រផលិតផល ឬរទេះនឹងរំលងជំហានពិនិត្យ ហើយទៅផ្ទាល់ទៅទំព័រអរគុណ។"

#: ppcp/includes/class-ppcp-paypal-checkout-for-woocommerce-settings.php:2022
msgid "Invoice prefix"
msgstr "បុព្វបទវិក្កយបត្រ"

#: ppcp/includes/class-ppcp-paypal-checkout-for-woocommerce-settings.php:2024
msgid "Please enter a prefix for your invoice numbers. If you use your PayPal account for multiple stores ensure this prefix is unique as PayPal will not allow orders with the same invoice number."
msgstr "សូមបញ្ចូលបុព្វបទសម្រាប់លេខវិក្កយបត្ររបស់អ្នក។ ប្រសិនបើអ្នកប្រើគណនី PayPal របស់អ្នកសម្រាប់ហាងច្រើន សូមប្រាកដថាបុព្វបទនេះមានលក្ខណៈពិសេស ព្រោះ PayPal នឹងមិនអនុញ្ញាតឱ្យការបញ្ជាទិញដែលមានលេខវិក្កយបត្រដូចគ្នា។"

#: ppcp/includes/class-ppcp-paypal-checkout-for-woocommerce-settings.php:2029
msgid "Credit Card Statement Name"
msgstr "ឈ្មោះរបាយការណ៍កាតឥណទាន"

#: ppcp/includes/class-ppcp-paypal-checkout-for-woocommerce-settings.php:2031
msgid "The value entered here will be displayed on the buyer's credit card statement."
msgstr "តម្លៃដែលបានបញ្ចូលនៅទីនេះនឹងត្រូវបានបង្ហាញលើរបាយការណ៍កាតឥណទានរបស់អ្នកទិញ។"

#: ppcp/includes/class-ppcp-paypal-checkout-for-woocommerce-settings.php:2045
msgid "Debug log"
msgstr "កំណត់ហេតុបំបាត់កំហុស"

#: ppcp/includes/class-ppcp-paypal-checkout-for-woocommerce-settings.php:2047
msgid "Enable logging"
msgstr "បើកការកត់ត្រា"

#. translators: %s is the path to the WooCommerce PayPal debug log file.
