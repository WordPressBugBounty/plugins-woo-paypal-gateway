#: ppcp/includes/class-ppcp-paypal-checkout-for-woocommerce-gateway.php:1275
msgid "The Connect to PayPal service is temporarily unavailable."
msgstr "សេវា Connect to PayPal មិនអាចប្រើបានជាបណ្ដោះអាសន្ន។"

#: ppcp/includes/class-ppcp-paypal-checkout-for-woocommerce-gateway.php:1279
msgid "Toggle to manual credential input"
msgstr "ប្តូរទៅការបញ្ចូលអត្តសញ្ញាណដោយដៃ"

#: ppcp/includes/class-ppcp-paypal-checkout-for-woocommerce-gateway.php:1306
msgid "Recommended"
msgstr "ត្រូវបានណែនាំ"

#: ppcp/includes/class-ppcp-paypal-checkout-for-woocommerce-gateway.php:1311
