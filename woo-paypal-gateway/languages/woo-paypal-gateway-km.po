msgid "Invalid capture date."
msgstr "កាលបរិច្ឆេដចាប់យកមិនត្រឹមត្រូវ។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1422
msgid "Unsupported currency for this card."
msgstr "រូបិយប័ណ្ណមិនត្រូវបានគាំទ្រសម្រាប់កាតនេះ។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1423
msgid "Invalid account number."
msgstr "លេខគណនេយ្យមិនត្រឹមត្រូវ។"

