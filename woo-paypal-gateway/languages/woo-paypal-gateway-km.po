#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1406
msgid "Transaction declined. Please retry."
msgstr "ប្រតិបត្តិការត្រូវបានបឋិសេធ។ សូមសាកល្បងម្តងទៀត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1407
msgid "Suspected fraud. Please use another payment method."
msgstr "សង្ស័យការប្រតិបត្តិការកេល org។ សូមប្រើវិធីបង់ប្រាក់ផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1408
msgid "Security violation. Please contact your card issuer."
msgstr "ការលើកលែងសុវត្ថិភាព។ សូមទាក់ទងអ្នកគ្រប់គ្រងកាត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1409
msgid "Card reported lost or stolen. Please use another card."
msgstr "កាតត្រូវបានរាយការណ៍បាត់ ឬត្រូវបានលួច។ សូមប្រើកាតផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1410
msgid "Hold - call center. Please contact your card issuer."
msgstr "សូមរោលើក - ត្រូវទាក់ទងមជ្ឈមណ្ឌល។ សូមទាក់ទងអ្នកគ្រប់គ្រងកាត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1411
msgid "Card refused. Please use another payment method."
msgstr "កាតត្រូវបានបឋិសេធ។ សូមប្រើវិធីបង់ប្រាក់ផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1412
msgid "Unrecognized response code. Please try again later."
msgstr "កូដចម្លើយមិនត្រូវបានស្គាល់។ សូមសាកល្បងម្តងទៀតនៅពេលក្រោយ។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1413
msgid "Contingencies not resolved. Please try again."
msgstr "លក្ខខណ្ឌណែនាំមិនត្រូវបានដោះស្រាយ។ សូមសាកល្បងម្តងទៀត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1414 ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1427
msgid "CVV verification failed. Please check your CVV."
msgstr "ការផ្ទៀងផ្ទាត់ CVV បានបរាជ័យ។ សូមពិនិត្យមើល CVV របស់អ្នក។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1415
msgid "Account closed. Please use another card."
msgstr "គណនេយ្យត្រូវបានបិទ។ សូមប្រើកាតផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1416
msgid "Reattempt not permitted. Please use another payment method."
msgstr "ការព្យាយាមម្តងទៀតមិនត្រូវបានអនុញ្ញាត។ សូមប្រើវិធីបង់ប្រាក់ផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1417
msgid "Billing address error. Please check your billing details."
msgstr "កំហុសអាសយដ្ឋានវិក្កយបត្រ។ សូមពិនិត្យលម្អិតនៃវិក្កយបត្ររបស់អ្នក។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1418
msgid "Account blocked by issuer. Please contact your card issuer."
msgstr "គណនេយ្យត្រូវបានធ្វើអាសន្នដោយអ្នកគ្រប់គ្រងកាត។ សូមទាក់ទងអ្នកគ្រប់គ្រងកាត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1419
msgid "American Express card disabled. Please use another card."
msgstr "កាត American Express ត្រូវបានបិទ។ សូមប្រើកាតផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1420
msgid "Adult gaming not supported. Please use another payment method."
msgstr "ល្បែងសម្រាប់មនុស្សពេញវ័យមិនត្រូវបានគាំទ្រ។ សូមប្រើវិធីបង់ប្រាក់ផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1421
msgid "Amount incompatible. Please try a different amount."
msgstr "ចំនួនទឹកប្រាក់មិនឆបបសម។ សូមសាកល្បងចំនួនផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1422
msgid "Authorization result error. Please try again."
msgstr "កំហុសលទ្ធផលនៃការអនុញ្ញាត។ សូមសាកល្បងម្តងទៀត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1423
msgid "MCC code error. Please contact support."
msgstr "កំហុសកូដ MCC។ សូមទាក់ទងផ្នែកគាំទ្រ។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1424
msgid "Address verification failed. Please check your billing address."
msgstr "ការផ្ទៀងផ្ទាត់អាសយដ្ឋានបានបរាជ័យ។ សូមពិនិត្យអាសយដ្ឋានវិក្កយបត្ររបស់អ្នក។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1425
msgid "Amount exceeded. Please try a smaller amount."
msgstr "ចំនួនទឹកប្រាក់លើស។ សូមសាកល្បងចំនួនតិចជាង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1426
msgid "Gaming transaction error. Please use another payment method."
msgstr "កំហុសប្រតិបត្តិការល្បែង។ សូមប្រើវិធីបង់ប្រាក់ផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1428
msgid "Registration incomplete. Please complete registration."
msgstr "ការចុះឈ្មោះមិនទាន់បញ្ចប់។ សូមបញ្ចប់ការចុះឈ្មោះ។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1429
msgid "Country error. Please try another payment method."
msgstr "កំហុសប្រទេស។ សូមសាកល្បងវិធីបង់ប្រាក់ផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1430
msgid "Credit error. Please try another payment method."
msgstr "កំហុសឥណទាន។ សូមសាកល្បងវិធីបង់ប្រាក់ផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1431
msgid "Card type not supported. Please use another card."
msgstr "ប្រភេទកាតមិនត្រូវបានគាំទ្រ។ សូមប្រើកាតផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1432
msgid "Invalid currency. Please select a supported currency."
msgstr "រូបិយប័ណ្ណមិនត្រឹមត្រូវ។ សូមជ្រើសរើសរូបិយប័ណ្ណដែលគាំទ្រ។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1433
msgid "3D Secure authentication error. Please try again."
msgstr "កំហុសការផ្ទៀងផ្ទាត់ 3D Secure។ សូមសាកល្បងម្តងទៀត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1434
msgid "Dynamic currency conversion not supported. Please try again."
msgstr "ការប្តូររូបិយប័ណ្ណថាមវន្តមិនត្រូវបានគាំទ្រ។ សូមសាកល្បងម្តងទៀត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1435
msgid "Diners Club card rejected. Please use another card."
msgstr "កាត Diners Club ត្រូវបានបឋិសេធ។ សូមប្រើកាតផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1436
msgid "Authentication message error. Please try again."
msgstr "កំហុសសារផ្ទៀងផ្ទាត់។ សូមសាកល្បងម្តងទៀត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1437
msgid "Decline threshold exceeded. Please try again later."
msgstr "ធ្រេសហោដការបឋិសេធលើស។ សូមសាកល្បងម្តងទៀតនៅពេលក្រោយ។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1438
msgid "Funding instrument expired. Please use another payment method."
msgstr "ឧបករណ៍ហិរញ្ញវត្ថុផុតកំណត់។ សូមប្រើវិធីបង់ប្រាក់ផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1439
msgid "Frequency limit exceeded. Please try again later."
msgstr "ដែនកំណត់ប្រេកកង់សលើស។ សូមសាកល្បងម្តងទៀតនៅពេលក្រោយ។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1440
msgid "System error. Please try again later."
msgstr "កំហុសប្រព័ន្ធ។ សូមសាកល្បងម្តងទៀតនៅពេលក្រោយ។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1441
msgid "Expiry date error. Please check your card details."
msgstr "កំហុសកាលបរិច្ឆេទផុតកំណត់។ សូមពិនិត្យមើលព័ត៌មានកាត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1442
msgid "Funding source already exists. Please use another payment method."
msgstr "ប្រភពថវិកាមានរួចហើយ។ សូមប្រើវិធីបង់ប្រាក់ផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1443
msgid "Invalid funding instrument. Please try another payment method."
msgstr "ឧបករណ៍ហិរញ្ញវត្ថុមិនត្រឹមត្រូវ។ សូមសាកល្បងវិធីបង់ប្រាក់ផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1444
msgid "Restricted funding instrument. Please try another payment method."
msgstr "ឧបករណ៍ហិរញ្ញវត្ថុត្រូវបានដាក់កម្រិត។ សូមសាកល្បងវិធីបង់ប្រាក់ផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1445
msgid "Field validation failed. Please check your payment details."
msgstr "ការផ្ទៀងផ្ទាត់វាលបានបរាជ័យ។ សូមពិនិត្យមើលព័ត៌មានការបង់ប្រាក់។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1446
msgid "Gaming refund error. Please contact support."
msgstr "កំហុសការសងប្រាក់ល្បែង។ សូមទាក់ទងផ្នែកគាំទ្រ។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1447 ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1456
msgid "Processing error. Please try again."
msgstr "កំហុសការដំណើរការ។ សូមសាកល្បងម្តងទៀត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1448
msgid "Idempotency failure. Please try again."
msgstr "កំហុស Idempotency។ សូមសាកល្បងម្តងទៀត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1449
msgid "Invalid input. Please check your payment details."
msgstr "ការបញ្ចូលមិនត្រឹមត្រូវ។ សូមពិនិត្យមើលព័ត៌មានការបង់ប្រាក់។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1450
msgid "ID mismatch. Please try again."
msgstr "ID មិនត្រូវ។ សូមសាកល្បងម្តងទៀត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1451
msgid "Invalid trace ID. Please try again."
msgstr "ID ដានមិនត្រឹមត្រូវ។ សូមសាកល្បងម្តងទៀត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1452
msgid "Late reversal. Please contact support."
msgstr "ការប្រតិវត្តយឺត។ សូមទាក់ទងផ្នែកគាំទ្រ។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1453
msgid "Status code error. Please try again."
msgstr "កំហុសកូដស្ថានភាព។ សូមសាកល្បងម្តងទៀត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1454
msgid "Missing business rule or data. Please try again."
msgstr "បាត់ច្បាប់អាជីវកម្ម ឬទិន្នន័យ។ សូមសាកល្បងម្តងទៀត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1455
msgid "Mastercard blocked. Please use another card."
msgstr "Mastercard ត្រូវបានរារាំង។ សូមប្រើកាតផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1457
msgid "Not supported. Please try another payment method."
msgstr "មិនត្រូវបានគាំទ្រ។ សូមសាកល្បងវិធីបង់ប្រាក់ផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1458
msgid "Network frequency limit exceeded. Please try again later."
msgstr "ដែនកំណត់ប្រេកកង់សបណ្តាញលើស។ សូមសាកល្បងម្តងទៀតនៅពេលក្រោយ។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1459
msgid "Merchant ID not found. Please contact support."
msgstr "ID អ្នកពាណិជ្ជកម្មមិនត្រូវបានរកឃើញ។ សូមទាក់ទងផ្នែកគាំទ្រ។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1460
msgid "Network error. Please try again later."
msgstr "កំហុសបណ្តាញ។ សូមសាកល្បងម្តងទៀតនៅពេលក្រោយ។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1461
msgid "Phone required for this transaction. Please update your details."
msgstr "ទាមទារលេខទូរស័ព្ទសម្រាប់ប្រតិបត្តិការនេះ។ សូមធ្វើបច្ចុប្បន្នភាពព័ត៌មានរបស់អ្នក។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1462
msgid "Invalid product. Please try another product."
msgstr "ផលិតផលមិនត្រឹមត្រូវ។ សូមសាកល្បងផលិតផលផ្សេង។"

