msgid "Card type not supported. Please use another card."
msgstr "ប្រភេទកាតមិនត្រូវបានគាំទ្រ។ សូមប្រើកាតផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1507
msgid "Invalid currency. Please select a supported currency."
msgstr "រូបិយប័ណ្ណមិនត្រឹមត្រូវ។ សូមជ្រើសរើសរូបិយប័ណ្ណដែលគាំទ្រ។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1508
msgid "3D Secure authentication error. Please try again."
msgstr "កំហុសការផ្ទៀងផ្ទាត់ 3D Secure។ សូមសាកល្បងម្តងទៀត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1509
msgid "Dynamic currency conversion not supported. Please try again."
msgstr "ការប្តូររូបិយប័ណ្ណថាមវន្តមិនត្រូវបានគាំទ្រ។ សូមសាកល្បងម្តងទៀត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1510
msgid "Diners Club card rejected. Please use another card."
msgstr "កាត Diners Club ត្រូវបានបឋិសេធ។ សូមប្រើកាតផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1511
msgid "Authentication message error. Please try again."
msgstr "កំហុសសារផ្ទៀងផ្ទាត់។ សូមសាកល្បងម្តងទៀត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1512
msgid "Decline threshold exceeded. Please try again later."
msgstr "ធ្រេសហោដការបឋិសេធលើស។ សូមសាកល្បងម្តងទៀតនៅពេលក្រោយ។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1513
msgid "Funding instrument expired. Please use another payment method."
msgstr "ឧបករណ៍ហិរញ្ញវត្ថុផុតកំណត់។ សូមប្រើវិធីបង់ប្រាក់ផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1514
msgid "Frequency limit exceeded. Please try again later."
msgstr "ដែនកំណត់ប្រេកកង់សលើស។ សូមសាកល្បងម្តងទៀតនៅពេលក្រោយ។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1515
msgid "System error. Please try again later."
msgstr "កំហុសប្រព័ន្ធ។ សូមសាកល្បងម្តងទៀតនៅពេលក្រោយ។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1516
msgid "Expiry date error. Please check your card details."
msgstr "កំហុសកាលបរិច្ឆេទផុតកំណត់។ សូមពិនិត្យមើលព័ត៌មានកាត។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1517
msgid "Funding source already exists. Please use another payment method."
msgstr "ប្រភពថវិកាមានរួចហើយ។ សូមប្រើវិធីបង់ប្រាក់ផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1518
msgid "Invalid funding instrument. Please try another payment method."
msgstr "ឧបករណ៍ហិរញ្ញវត្ថុមិនត្រឹមត្រូវ។ សូមសាកល្បងវិធីបង់ប្រាក់ផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1519
msgid "Restricted funding instrument. Please try another payment method."
msgstr "ឧបករណ៍ហិរញ្ញវត្ថុត្រូវបានដាក់កម្រិត។ សូមសាកល្បងវិធីបង់ប្រាក់ផ្សេង។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1520
msgid "Field validation failed. Please check your payment details."
msgstr "ការផ្ទៀងផ្ទាត់វាលបានបរាជ័យ។ សូមពិនិត្យមើលព័ត៌មានការបង់ប្រាក់។"

#: ppcp/includes/ppcp-paypal-checkout-for-woocommerce-function.php:1521
msgid "Gaming refund error. Please contact support."
msgstr "កំហុសការសងប្រាក់ល្បែង។ សូមទាក់ទងផ្នែកគាំទ្រ។"

