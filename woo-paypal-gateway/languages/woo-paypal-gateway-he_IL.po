msgid "Find the <strong>Disable Specific Payment Buttons</strong> setting."
msgstr "מצא את ההגדרה <strong>השבת כפתורי תשלום ספציפיים</strong>."

#: ppcp/includes/class-ppcp-paypal-checkout-for-woocommerce-gateway.php:1438
msgid "Select <strong>Pay Later</strong> from the dropdown list."
msgstr "בחר <strong>שלם מאוחר יותר</strong> מהרשימה הנפתחת."

